{
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "F=\"${CLAUDE_PROJECT_DIR:-.}/scripts/check_file_placement.py\"; if [ -f \"$F\" ]; then python3 \"$F\" --hook; else exit 0; fi",
            "timeout": 10,
            "statusMessage": "Kiem tra vi tri file"
          }
        ]
      }
    ]
  }
}
